# JWT
JWT_SECRET=replace-with-a-long-base64-or-random-secret
JWT_EXPIRATION_MS=86400000

# Mail
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password

# OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github
OAUTH2_REDIRECT_URI=http://localhost:5173

# Eureka
EUREKA_USERNAME=change-me
EUREKA_PASSWORD=change-me
EUREKA_HOST=eureka-server
EUREKA_PORT=8761

# Spring Boot Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_HOST=admin-server
ADMIN_PORT=8090

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth database
AUTH_DB_PROFILE=prod
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=qma_auth
MYSQL_USERNAME=qma_user
MYSQL_PASSWORD=change-me
MYSQL_DDL_AUTO=update
MYSQL_USE_SSL=false
